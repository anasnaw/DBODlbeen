# Copy to .env (or set these in your hosting dashboard)
PORT=3000
# Folder for the database and uploaded files. MUST be on a persistent disk / volume.
DATA_DIR=./data
# First super user (only used the very first time the server starts with an empty database)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now-please
ADMIN_NAME=Super Admin
# Sessions: sign-out after this many idle minutes on the server side (the app also locks after 30 min)
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=24
# Largest single attachment upload
MAX_FILE_MB=100
